@model IslemListeVM
@{
    ViewData["Title"] = "İşlemler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-list-ul"></i>İşlem Listesi</h2>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-all-route-data="@GetFilterRouteData(Model)" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-filetype-csv me-1"></i>CSV
        </a>
        <a asp-action="ExportExcel" asp-all-route-data="@GetFilterRouteData(Model)" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </a>
        <a asp-action="Ekle" class="btn btn-ecu">
            <i class="bi bi-plus-circle me-1"></i>Yeni İşlem
        </a>
    </div>
</div>

<!-- İstatistik Şeridi -->
<div class="stat-strip">
    <div class="stat-item">
        <div class="stat-icon gold"><i class="bi bi-car-front-fill"></i></div>
        <div>
            <div class="stat-value">@Model.ToplamKayit</div>
            <div class="stat-label">Toplam İşlem</div>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon blue"><i class="bi bi-people-fill"></i></div>
        <div>
            <div class="stat-value">@Model.KullaniciListesi.Count</div>
            <div class="stat-label">Kullanıcı</div>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon green"><i class="bi bi-camera-fill"></i></div>
        <div>
            <div class="stat-value">@Model.Islemler.Sum(i => i.FotoSayisi)</div>
            <div class="stat-label">Fotoğraf</div>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon amber"><i class="bi bi-calendar-check"></i></div>
        <div>
            <div class="stat-value">@Model.Islemler.Count(i => i.EklenmeTarihi.Date == DateTime.Today)</div>
            <div class="stat-label">Bugün</div>
        </div>
    </div>
</div>

<!-- Arama Barı -->
<div class="mb-4">
    <form method="get" asp-action="Index">
        <div class="d-flex gap-2 align-items-end flex-wrap">
            <div class="flex-grow-1">
                <input asp-for="Arama" class="form-control" placeholder="Plaka, araç sahibi, telefon, e-posta veya işlem ara..." />
            </div>
            <div>
                <input asp-for="BaslangicTarih" type="date" class="form-control" title="Başlangıç Tarihi" />
            </div>
            <div>
                <input asp-for="BitisTarih" type="date" class="form-control" title="Bitiş Tarihi" />
            </div>
            <button type="submit" class="btn btn-ecu">
                <i class="bi bi-search me-1"></i>Ara
            </button>
            @if (HasActiveFilter(Model))
            {
                <a asp-action="Index" class="btn btn-outline-ecu">
                    <i class="bi bi-x-lg me-1"></i>Temizle
                </a>
            }
        </div>
    </form>
</div>

<!-- Sonuç Tablosu -->
@if (Model.Islemler.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>Kayıt bulunamadı.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="ecu-thead">
                    <tr>
                        <th>Plaka</th>
                        <th>Araç Sahibi</th>
                        <th>Telefon</th>
                        <th>E-Posta</th>
                        <th>Yapılan İşlem</th>
                        <th>Tarih</th>
                        <th>Foto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var islem in Model.Islemler)
                    {
                        <tr>
                            <td><span class="plaka-badge">@islem.AracPlaka</span></td>
                            <td>@islem.AracSahibi</td>
                            <td>
                                @if (!string.IsNullOrEmpty(islem.Telefon))
                                {
                                    <a href="tel:@islem.Telefon" class="text-decoration-none" style="color:var(--text-ecu);">
                                        <i class="bi bi-telephone me-1"></i>@islem.Telefon
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(islem.Email))
                                {
                                    <a href="mailto:@islem.Email" class="text-decoration-none" style="color:var(--text-ecu);">
                                        <i class="bi bi-envelope me-1"></i>@islem.Email
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (islem.YapilanIslem.Length > 40)
                                {
                                    @islem.YapilanIslem[..40]<text>...</text>
                                }
                                else
                                {
                                    @islem.YapilanIslem
                                }
                            </td>
                            <td><small>@islem.EklenmeTarihi.ToString("dd.MM.yyyy HH:mm")</small></td>
                            <td>
                                @if (islem.FotoSayisi > 0)
                                {
                                    <span class="badge badge-ecu">
                                        <i class="bi bi-camera me-1"></i>@islem.FotoSayisi
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detay" asp-route-id="@islem.Id" class="btn btn-sm btn-outline-ecu">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sayfalama -->
    @if (Model.ToplamSayfa > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.Sayfa <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-Arama="@Model.Arama"
                       asp-route-BaslangicTarih="@Model.BaslangicTarih?.ToString("yyyy-MM-dd")"
                       asp-route-BitisTarih="@Model.BitisTarih?.ToString("yyyy-MM-dd")"
                       asp-route-Sayfa="@(Model.Sayfa - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.ToplamSayfa; p++)
                {
                    <li class="page-item @(p == Model.Sayfa ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-Arama="@Model.Arama"
                           asp-route-BaslangicTarih="@Model.BaslangicTarih?.ToString("yyyy-MM-dd")"
                           asp-route-BitisTarih="@Model.BitisTarih?.ToString("yyyy-MM-dd")"
                           asp-route-Sayfa="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Sayfa >= Model.ToplamSayfa ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-Arama="@Model.Arama"
                       asp-route-BaslangicTarih="@Model.BaslangicTarih?.ToString("yyyy-MM-dd")"
                       asp-route-BitisTarih="@Model.BitisTarih?.ToString("yyyy-MM-dd")"
                       asp-route-Sayfa="@(Model.Sayfa + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }

    <p class="text-center mt-2" style="color: var(--text-muted); font-size:0.85rem;">
        Toplam <strong style="color: var(--ecu-red);">@Model.ToplamKayit</strong> kayıt
        @if (Model.ToplamSayfa > 1)
        {
            <text>— Sayfa @Model.Sayfa / @Model.ToplamSayfa</text>
        }
    </p>
}

@functions {
    bool HasActiveFilter(IslemListeVM m) =>
        !string.IsNullOrEmpty(m.Arama) ||
        m.BaslangicTarih.HasValue ||
        m.BitisTarih.HasValue;

    Dictionary<string, string> GetFilterRouteData(IslemListeVM m)
    {
        var d = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(m.Arama)) d["Arama"] = m.Arama;
        if (m.BaslangicTarih.HasValue) d["BaslangicTarih"] = m.BaslangicTarih.Value.ToString("yyyy-MM-dd");
        if (m.BitisTarih.HasValue) d["BitisTarih"] = m.BitisTarih.Value.ToString("yyyy-MM-dd");
        return d;
    }
}
