@model IslemListeVM
@{
    ViewData["Title"] = "İşlemler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-list-ul me-2"></i>İşlem Listesi</h2>
    <a asp-action="Ekle" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni İşlem
    </a>
</div>

<!-- Filtre Paneli -->
<div class="card mb-4">
    <div class="card-header" data-bs-toggle="collapse" data-bs-target="#filtrePanel" role="button">
        <i class="bi bi-funnel me-1"></i>Filtreler
        <i class="bi bi-chevron-down float-end"></i>
    </div>
    <div id="filtrePanel" class="collapse @(HasActiveFilter(Model) ? "show" : "")">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Plaka</label>
                        <input asp-for="Plaka" class="form-control" placeholder="34 ABC..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Araç Sahibi</label>
                        <input asp-for="AracSahibi" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input asp-for="BaslangicTarih" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input asp-for="BitisTarih" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ekleyen</label>
                        <select asp-for="EkleyenKullaniciId" class="form-select">
                            <option value="">-- Tümü --</option>
                            @foreach (var k in Model.KullaniciListesi)
                            {
                                <option value="@k.Id">@k.TamAd</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Min KM</label>
                        <input asp-for="MinKM" type="number" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Max KM</label>
                        <input asp-for="MaxKM" type="number" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>Filtrele
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Sonuç Tablosu -->
@if (Model.Islemler.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Kayıt bulunamadı.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Plaka</th>
                    <th>Araç Sahibi</th>
                    <th>KM</th>
                    <th>Yapılan İşlem</th>
                    <th>Ekleyen</th>
                    <th>Tarih</th>
                    <th>Foto</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var islem in Model.Islemler)
                {
                    <tr>
                        <td><strong>@islem.AracPlaka</strong></td>
                        <td>@islem.AracSahibi</td>
                        <td>@islem.AracKM.ToString("N0") km</td>
                        <td>
                            @if (islem.YapilanIslem.Length > 80)
                            {
                                @islem.YapilanIslem[..80]<text>...</text>
                            }
                            else
                            {
                                @islem.YapilanIslem
                            }
                        </td>
                        <td>@islem.EkleyenAd</td>
                        <td>@islem.EklenmeTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (islem.FotoSayisi > 0)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-camera me-1"></i>@islem.FotoSayisi
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-action="Detay" asp-route-id="@islem.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Toplam <strong>@Model.Islemler.Count</strong> kayıt</p>
}

@functions {
    bool HasActiveFilter(IslemListeVM m) =>
        !string.IsNullOrEmpty(m.Plaka) ||
        !string.IsNullOrEmpty(m.AracSahibi) ||
        m.BaslangicTarih.HasValue ||
        m.BitisTarih.HasValue ||
        m.EkleyenKullaniciId.HasValue ||
        m.MinKM.HasValue ||
        m.MaxKM.HasValue;
}
