@model Islem
@{
    ViewData["Title"] = $"İşlem — {Model.AracPlaka}";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title">
                <i class="bi bi-car-front"></i>
                <span class="plaka-badge" style="font-size:1.1rem;">@Model.AracPlaka</span>
            </h2>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-ecu">
                    <i class="bi bi-arrow-left me-1"></i>Liste
                </a>
                <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-ecu">
                    <i class="bi bi-pencil me-1"></i>Düzenle
                </a>
                <form asp-action="Sil" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Bu işlemi silmek istediğinize emin misiniz?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Sil
                    </button>
                </form>
            </div>
        </div>

        <!-- Araç Bilgileri -->
        <div class="card mb-4">
            <div class="card-header ecu-header">
                <i class="bi bi-info-circle me-1"></i>Araç Bilgileri
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="form-label" style="margin-bottom:0.15rem;">PLAKA</div>
                        <span class="fs-5 fw-bold">@Model.AracPlaka</span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="form-label" style="margin-bottom:0.15rem;">ARAÇ SAHİBİ</div>
                        <span class="fs-5 fw-bold">@Model.AracSahibi</span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="form-label" style="margin-bottom:0.15rem;">KİLOMETRE</div>
                        <span class="fs-5 fw-bold">@Model.AracKM.ToString("N0") km</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="form-label" style="margin-bottom:0.15rem;"><i class="bi bi-telephone me-1"></i>TELEFON</div>
                        <a href="tel:@Model.Telefon" class="fs-5 fw-bold text-decoration-none" style="color:var(--text-ecu);">@Model.Telefon</a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="form-label" style="margin-bottom:0.15rem;"><i class="bi bi-envelope me-1"></i>E-POSTA</div>
                        <a href="mailto:@Model.Email" class="fs-5 fw-bold text-decoration-none" style="color:var(--text-ecu);">@Model.Email</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Yapılan İşlem -->
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-wrench text-ecu me-1"></i>Yapılan İşlem
            </div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-wrap; line-height:1.7;">@Model.YapilanIslem</p>
            </div>
            <div class="card-footer" style="font-size:0.8rem;">
                Ekleyen: <strong>@Model.EkleyenKullanici.Ad @Model.EkleyenKullanici.Soyad</strong>
                — @Model.EklenmeTarihi.ToString("dd.MM.yyyy HH:mm")
                @if (Model.GuncelleyenKullanici != null)
                {
                    <br />
                    <text>Güncelleyen: <strong>@Model.GuncelleyenKullanici.Ad @Model.GuncelleyenKullanici.Soyad</strong>
                    — @Model.GuncellemeTarihi?.ToString("dd.MM.yyyy HH:mm")</text>
                }
            </div>
        </div>

        <!-- Fotoğraflar -->
        @if (Model.Fotograflar.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-camera text-ecu me-1"></i>Fotoğraflar
                    <span class="badge badge-ecu ms-2">@Model.Fotograflar.Count</span>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var foto in Model.Fotograflar)
                        {
                            <a href="@foto.DosyaYolu" class="glightbox" data-gallery="islem-galeri">
                                <img src="@foto.DosyaYolu" alt="@foto.OrijinalAd"
                                     class="foto-thumb" loading="lazy" />
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- İşlem Logları -->
        @if (Model.Loglar.Count > 0)
        {
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-clock-history text-ecu me-1"></i>İşlem Geçmişi
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="ecu-thead">
                            <tr>
                                <th>Aksiyon</th>
                                <th>Kullanıcı</th>
                                <th>Tarih</th>
                                <th>IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Loglar.OrderByDescending(l => l.LogTarihi))
                            {
                                <tr>
                                    <td>
                                        <span class="badge @GetAksiyonBadgeClass(log.Aksiyon)">
                                            @log.Aksiyon
                                        </span>
                                    </td>
                                    <td>@log.Kullanici.Ad @log.Kullanici.Soyad</td>
                                    <td>@log.LogTarihi.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td><small style="color:var(--text-muted);">@log.IPAdresi</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    const lightbox = GLightbox({ selector: '.glightbox' });
</script>
}

@functions {
    string GetAksiyonBadgeClass(string aksiyon) => aksiyon switch
    {
        "EKLE" => "bg-success",
        "GUNCELLE" => "bg-warning text-dark",
        "SIL" => "bg-danger",
        "GORUNTULE" => "bg-info",
        _ => "bg-secondary"
    };
}
