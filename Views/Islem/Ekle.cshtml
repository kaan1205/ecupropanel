@model IslemEkleVM
@{
    ViewData["Title"] = "Yeni İşlem Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="page-title mb-4"><i class="bi bi-plus-circle"></i>Yeni İşlem Ekle</h2>

        <div class="card">
            <div class="card-header ecu-header">
                <i class="bi bi-car-front me-1"></i>Araç & İşlem Bilgileri
            </div>
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.85rem;"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AracPlaka" class="form-label">ARAÇ PLAKA <span class="text-ecu">*</span></label>
                            <input asp-for="AracPlaka" class="form-control text-uppercase" placeholder="34 ABC 1234" autofocus />
                            <span asp-validation-for="AracPlaka" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AracSahibi" class="form-label">ARAÇ SAHİBİ <span class="text-ecu">*</span></label>
                            <input asp-for="AracSahibi" class="form-control" />
                            <span asp-validation-for="AracSahibi" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefon" class="form-label"><i class="bi bi-telephone me-1"></i>TELEFON <span class="text-ecu">*</span></label>
                            <input asp-for="Telefon" class="form-control" type="tel" placeholder="0532 123 4567" />
                            <span asp-validation-for="Telefon" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i>E-POSTA <span class="text-ecu">*</span></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="ornek@mail.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AracKM" class="form-label">KİLOMETRE <span class="text-ecu">*</span></label>
                        <div class="input-group">
                            <input asp-for="AracKM" type="number" class="form-control" min="0" max="9999999" />
                            <span class="input-group-text" style="background:var(--bg-card-header);color:var(--text-secondary);border-color:var(--border-color);">km</span>
                        </div>
                        <span asp-validation-for="AracKM" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="YapilanIslem" class="form-label">YAPILAN İŞLEM <span class="text-ecu">*</span></label>
                        <textarea asp-for="YapilanIslem" class="form-control" rows="4"
                                  placeholder="Stage 1 chip tuning, DPF off, EGR off..."></textarea>
                        <span asp-validation-for="YapilanIslem" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">FOTOĞRAFLAR</label>
                        <input id="fotoInput" name="Fotograflar" type="file" style="display:none;" multiple
                               accept=".jpg,.jpeg,.png,.webp" />
                        <input id="fotoInputKamera" type="file" style="display:none;"
                               accept="image/*" capture="environment" />
                        <div class="d-flex gap-2">
                            <button type="button" id="btnFotoSec" class="btn btn-outline-ecu">
                                <i class="bi bi-images me-1"></i>Fotoğraf Seç
                            </button>
                            <button type="button" id="btnFotoCek" class="btn btn-outline-ecu">
                                <i class="bi bi-camera me-1"></i>Fotoğraf Çek
                            </button>
                        </div>
                        <div class="form-text mt-1" style="color:var(--text-muted);">JPG, PNG veya WebP. Maksimum 5 MB / dosya.</div>
                        <div id="fotoOnizleme" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-ecu">
                            <i class="bi bi-check-circle me-1"></i>Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-ecu">
                            <i class="bi bi-arrow-left me-1"></i>İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function() {
        const container = document.getElementById('fotoOnizleme');
        const fotoInput = document.getElementById('fotoInput');
        const fotoInputKamera = document.getElementById('fotoInputKamera');
        const btnFotoSec = document.getElementById('btnFotoSec');
        const btnFotoCek = document.getElementById('btnFotoCek');
        const birikimliFotolar = [];

        function renderOnizleme() {
            container.innerHTML = '';
            birikimliFotolar.forEach(function(file, index) {
                const wrapper = document.createElement('div');
                wrapper.style.position = 'relative';
                wrapper.style.display = 'inline-block';

                const reader = new FileReader();
                reader.onload = function(ev) {
                    const img = document.createElement('img');
                    img.src = ev.target.result;
                    img.className = 'foto-thumb';
                    img.style.width = '100px';
                    img.style.height = '100px';
                    img.style.objectFit = 'cover';
                    img.style.borderRadius = '8px';
                    wrapper.appendChild(img);

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.innerHTML = '&times;';
                    btn.style.cssText = 'position:absolute;top:2px;right:2px;background:rgba(0,0,0,0.7);color:white;border:none;border-radius:50%;width:22px;height:22px;font-size:14px;line-height:1;cursor:pointer;';
                    btn.onclick = function() {
                        birikimliFotolar.splice(index, 1);
                        guncelleFormInput();
                        renderOnizleme();
                    };
                    wrapper.appendChild(btn);
                };
                reader.readAsDataURL(file);
                container.appendChild(wrapper);
            });
        }

        function guncelleFormInput() {
            const dt = new DataTransfer();
            birikimliFotolar.forEach(function(f) { dt.items.add(f); });
            fotoInput.files = dt.files;
        }

        function dosyaEkle(files) {
            for (const file of files) {
                if (!file.type.startsWith('image/')) continue;
                birikimliFotolar.push(file);
            }
            guncelleFormInput();
            renderOnizleme();
        }

        btnFotoSec.addEventListener('click', function() {
            fotoInput.click();
        });

        btnFotoCek.addEventListener('click', function() {
            fotoInputKamera.click();
        });

        fotoInput.addEventListener('change', function(e) {
            dosyaEkle(e.target.files);
        });

        fotoInputKamera.addEventListener('change', function(e) {
            dosyaEkle(e.target.files);
            fotoInputKamera.value = '';
        });
    })();
</script>
}
