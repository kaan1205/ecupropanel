@model RegisterVM
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_Layout";
}

<div class="row justify-content-center" style="margin-top: 5vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card">
            <div class="card-body">
                <div class="auth-header">
                    <img src="https://www.ecupro.com/images/logo.png" alt="EcuPro" class="auth-logo" />
                    <p>Yeni hesap oluşturun</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:0.85rem;"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ad" class="form-label">AD</label>
                            <input asp-for="Ad" class="form-control" autofocus />
                            <span asp-validation-for="Ad" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Soyad" class="form-label">SOYAD</label>
                            <input asp-for="Soyad" class="form-control" />
                            <span asp-validation-for="Soyad" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">EMAIL</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label">ŞİFRE</label>
                        <input asp-for="Sifre" class="form-control" placeholder="En az 6 karakter" />
                        <span asp-validation-for="Sifre" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SifreTekrar" class="form-label">ŞİFRE TEKRAR</label>
                        <input asp-for="SifreTekrar" class="form-control" />
                        <span asp-validation-for="SifreTekrar" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <button type="submit" class="btn btn-ecu w-100 mb-3 py-2">
                        <i class="bi bi-person-check me-1"></i>Kayıt Ol
                    </button>

                    <p class="text-center mb-0" style="font-size:0.85rem; color: var(--text-muted);">
                        Zaten hesabınız var mı?
                        <a asp-action="Login" class="fw-600">Giriş Yap</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
