@model LoginVM
@{
    ViewData["Title"] = "Giriş";
    Layout = "_Layout";
}

<div class="row justify-content-center" style="margin-top: 8vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card auth-card">
            <div class="card-body">
                <div class="auth-header">
                    <img src="https://www.ecupro.com/images/logo.png" alt="EcuPro" class="auth-logo" />
                    <p>Panele giriş yapın</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:0.85rem;"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">EMAIL</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label">ŞİFRE</label>
                        <input asp-for="Sifre" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="Sifre" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="BeniHatirla" class="form-check-input" />
                        <label asp-for="BeniHatirla" class="form-check-label" style="font-size:0.85rem;">Beni hatırla</label>
                    </div>

                    <button type="submit" class="btn btn-ecu w-100 mb-3 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                    </button>

                    <p class="text-center mb-0" style="font-size:0.85rem; color: var(--text-muted);">
                        Hesabınız yok mu?
                        <a asp-action="Register" class="fw-600">Kayıt Ol</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
