@{
    ViewData["Title"] = "Onay Bekleniyor";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card text-center">
            <div class="card-body p-5">
                <div style="font-size:4rem;color:var(--ecu-gold);margin-bottom:1rem;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <h3 class="mb-3" style="color:var(--text-primary);">Onay Bekleniyor</h3>
                <p style="color:var(--text-secondary);line-height:1.7;">
                    Hesabınız başarıyla oluşturuldu.<br />
                    Panele erişim için bir <strong style="color:var(--ecu-gold);">yönetici</strong> tarafından
                    hesabınızın onaylanması gerekmektedir.
                </p>
                <p style="color:var(--text-muted);font-size:0.85rem;" class="mb-4">
                    Onaylandıktan sonra tekrar giriş yaparak paneli kullanabilirsiniz.
                </p>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-ecu">
                        <i class="bi bi-box-arrow-right me-1"></i>Çıkış Yap
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
