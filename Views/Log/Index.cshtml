@model List<IslemLog>
@{
    ViewData["Title"] = "Sistem Logları";
}

<h2 class="page-title mb-4"><i class="bi bi-clock-history"></i>Sistem Logları</h2>

<!-- Filtreler -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">AKSİYON</label>
                <select name="aksiyon" class="form-select">
                    <option value="">-- Tümü --</option>
                    @foreach (var a in (string[])ViewBag.Aksiyonlar)
                    {
                        <option value="@a" selected="@(Context.Request.Query["aksiyon"] == a)">@a</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">KULLANICI</label>
                <select name="kullaniciId" class="form-select">
                    <option value="">-- Tümü --</option>
                    @foreach (dynamic k in (dynamic)ViewBag.Kullanicilar)
                    {
                        <option value="@k.Id">@k.TamAd</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">BAŞLANGIÇ</label>
                <input type="date" name="baslangic" class="form-control" value="@Context.Request.Query["baslangic"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label">BİTİŞ</label>
                <input type="date" name="bitis" class="form-control" value="@Context.Request.Query["bitis"]" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-ecu w-100">
                    <i class="bi bi-search me-1"></i>Filtrele
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>Log kaydı bulunamadı.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="ecu-thead">
                    <tr>
                        <th>Tarih</th>
                        <th>Aksiyon</th>
                        <th>Kullanıcı</th>
                        <th>İşlem</th>
                        <th>IP Adresi</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td><small>@log.LogTarihi.ToString("dd.MM.yyyy HH:mm:ss")</small></td>
                            <td>
                                <span class="badge @GetBadge(log.Aksiyon)">@log.Aksiyon</span>
                            </td>
                            <td>@log.Kullanici.Ad @log.Kullanici.Soyad</td>
                            <td>
                                @if (log.IslemId.HasValue && log.Islem != null)
                                {
                                    <a asp-controller="Islem" asp-action="Detay" asp-route-id="@log.IslemId">
                                        <span class="plaka-badge" style="font-size:0.75rem;">#@log.IslemId — @log.Islem.AracPlaka</span>
                                    </a>
                                }
                                else if (log.IslemId.HasValue)
                                {
                                    <small style="color:var(--text-muted);">#@log.IslemId (silinmiş)</small>
                                }
                            </td>
                            <td><small style="color:var(--text-muted);">@log.IPAdresi</small></td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.DetayJson))
                                {
                                    <button class="btn btn-sm btn-outline-ecu" data-bs-toggle="popover"
                                            data-bs-content="@log.DetayJson" data-bs-trigger="focus"
                                            style="padding:0.15rem 0.5rem; font-size:0.75rem;">
                                        <i class="bi bi-code-square"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-center mt-3" style="color:var(--text-muted); font-size:0.85rem;">
        Son <strong style="color:var(--ecu-red);">@Model.Count</strong> kayıt (max 500)
    </p>
}

@section Scripts {
<script>
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
        new bootstrap.Popover(el);
    });
</script>
}

@functions {
    string GetBadge(string aksiyon) => aksiyon switch
    {
        "GIRIS" => "bg-primary",
        "CIKIS" => "bg-secondary",
        "KAYIT" => "bg-info",
        "EKLE" => "bg-success",
        "GUNCELLE" => "bg-warning text-dark",
        "SIL" => "bg-danger",
        "GORUNTULE" => "bg-info",
        _ => "bg-secondary"
    };
}
