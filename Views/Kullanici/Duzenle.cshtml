@model KullaniciDuzenleVM
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="page-title mb-4"><i class="bi bi-person-gear"></i>Kullanıcı Düzenle</h2>

        <div class="card">
            <div class="card-header ecu-header">
                <i class="bi bi-person me-1"></i>Kullanıcı Bilgileri
            </div>
            <div class="card-body p-4">
                <form asp-action="Duzenle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.85rem;"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ad" class="form-label">AD <span class="text-ecu">*</span></label>
                            <input asp-for="Ad" class="form-control" />
                            <span asp-validation-for="Ad" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Soyad" class="form-label">SOYAD <span class="text-ecu">*</span></label>
                            <input asp-for="Soyad" class="form-control" />
                            <span asp-validation-for="Soyad" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">EMAIL <span class="text-ecu">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label">ROL <span class="text-ecu">*</span></label>
                        <select asp-for="Rol" class="form-select">
                            <option value="Kullanici">Kullanıcı</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="AktifMi" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="AktifMi" class="form-check-label">Aktif Kullanıcı</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-ecu">
                            <i class="bi bi-check-circle me-1"></i>Güncelle
                        </button>
                        <a asp-action="Index" class="btn btn-outline-ecu">
                            <i class="bi bi-arrow-left me-1"></i>İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
